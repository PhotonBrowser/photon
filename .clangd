If:
  PathMatch: .*native/embedder/.*\.(cpp|h|hpp)
CompileFlags:
  Compiler: clang++
  Add:
    - -x
    - c++
    - -std=c++20
    - -I.
    - -Imacos
    - -I../../Engine/Libraries/LibPhotonEmbedder/include
    - -I../../Engine/Libraries
    - -I../../build/engine-release/Libraries
    - -I../../build/engine-debug/Libraries
---
If:
  PathMatch: .*native/embedder/.*\.mm
CompileFlags:
  Compiler: clang++
  Add:
    - -x
    - objective-c++
    - -std=c++20
    - -fobjc-arc
    - -fblocks
    - -I.
    - -I..
    - -I../../../Engine/Libraries/LibPhotonEmbedder/include
    - -I../../../Engine/Libraries
    - -I../../../build/engine-release/Libraries
    - -I../../../build/engine-debug/Libraries
---
If:
  PathMatch: .*crates/photon-presentation-ipc/native/.*\.m
CompileFlags:
  Compiler: clang
  Add:
    - -x
    - objective-c
    - -fobjc-arc
    - -fblocks
...
