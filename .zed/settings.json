{
  "file_types": {
    "C++": ["cc", "cpp", "cxx", "hh", "hpp", "hxx", "ipp", "tpp", "h", "C", "H"]
  },
  "languages": {
    "TSX": {
      "formatter": {
        "external": {
          "command": "bunx",
          "arguments": ["biome", "format", "--stdin-file-path", "{buffer_path}"]
        }
      },
      "format_on_save": "on"
    },
    "TypeScript": {
      "formatter": {
        "external": {
          "command": "bunx",
          "arguments": ["biome", "format", "--stdin-file-path", "{buffer_path}"]
        }
      },
      "format_on_save": "on"
    }
  }
}
