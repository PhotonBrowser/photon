{
  "files.watcherExclude": {
    "**/.git/**": true,
    "**/build/**": true,
    "**/target/**": true,
    "**/vcpkg_installed/**": true
  },
  "search.exclude": {
    "**/build/**": true,
    "**/target/**": true,
    "**/vcpkg_installed/**": true
  },
  "[typescript]": {
    "editor.defaultFormatter": "biomejs.biome"
  },
  "[typescriptreact]": {
    "editor.defaultFormatter": "biomejs.biome"
  },
  "editor.formatOnSave": true
}
