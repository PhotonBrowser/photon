#   cmake -DENGINE=<build/engine-*> -DPROFILE=Release|Debug -DAPP=<Photon> -DSTAGE=<new folder> -P stage.cmake
cmake_minimum_required(VERSION 3.21)

foreach (variable IN ITEMS ENGINE PROFILE APP STAGE)
    if ("${${variable}}" STREQUAL "")
        message(FATAL_ERROR "${variable} is required")
    endif()
endforeach()
if (EXISTS "${STAGE}")
    message(FATAL_ERROR "the staging folder already exists: ${STAGE}")
endif()
if (NOT EXISTS "${ENGINE}/CMakeCache.txt")
    message(FATAL_ERROR "${ENGINE} is not a configured Photon Engine build")
endif()

set(cache_entries CMAKE_BUILD_TYPE CMAKE_HOME_DIRECTORY CMAKE_INSTALL_LIBDIR PHOTON_HELPER_PROCESS_DIR
    VCPKG_INSTALLED_DIR VCPKG_TARGET_TRIPLET)
load_cache("${ENGINE}" READ_WITH_PREFIX engine_ ${cache_entries})
foreach (entry IN LISTS cache_entries)
    if ("${engine_${entry}}" STREQUAL "")
        message(FATAL_ERROR "${ENGINE}/CMakeCache.txt has no ${entry}; finish configuring the Engine first")
    endif()
endforeach()
if (NOT engine_CMAKE_BUILD_TYPE STREQUAL PROFILE)
    message(FATAL_ERROR "${ENGINE} is a ${engine_CMAKE_BUILD_TYPE} build, not ${PROFILE}; refusing to mix profiles")
endif()

set(vcpkg_root "${engine_VCPKG_INSTALLED_DIR}/${engine_VCPKG_TARGET_TRIPLET}")
if (PROFILE STREQUAL "Release")
    set(vcpkg_libraries "${vcpkg_root}/lib")
else()
    set(vcpkg_libraries "${vcpkg_root}/debug/lib")
endif()
set(engine_libraries "${ENGINE}/${engine_CMAKE_INSTALL_LIBDIR}")
set(embedder "${engine_libraries}/liblagom-photonembedder.so")
set(resources "${ENGINE}/share/Lagom")

include("${engine_CMAKE_HOME_DIRECTORY}/Meta/CMake/ladybird_helper_processes.cmake")
set(executables "${APP}")
foreach (helper IN LISTS ladybird_helper_processes)
    list(APPEND executables "${engine_PHOTON_HELPER_PROCESS_DIR}/${helper}")
endforeach()

set(missing)
foreach (input IN LISTS executables embedder)
    if (NOT EXISTS "${input}")
        list(APPEND missing "${input}")
    endif()
endforeach()
if (NOT IS_DIRECTORY "${vcpkg_libraries}")
    list(APPEND missing "${vcpkg_libraries}/")
endif()
file(GLOB_RECURSE resource_files "${resources}/*")
if (NOT resource_files)
    list(APPEND missing "${resources}/")
endif()
if (missing)
    list(JOIN missing "\n  " missing)
    message(FATAL_ERROR "the ${PROFILE} build is incomplete; missing:\n  ${missing}")
endif()

file(GLOB vcpkg_files LIST_DIRECTORIES false "${vcpkg_libraries}/*.so*")
list(FILTER vcpkg_files INCLUDE REGEX "\\.so(\\.[0-9]+)*$")

find_program(objdump objdump REQUIRED)
function(read_elf file headers)
    execute_process(COMMAND "${objdump}" -p "${file}" OUTPUT_VARIABLE dump RESULT_VARIABLE result ERROR_QUIET)
    if (NOT result EQUAL 0 OR NOT dump MATCHES "file format elf64-x86-64")
        message(FATAL_ERROR "${file} is not an x86-64 ELF file")
    endif()
    set(${headers} "${dump}" PARENT_SCOPE)
endfunction()
foreach (input IN LISTS executables embedder vcpkg_files)
    read_elf("${input}" headers)
endforeach()

file(GET_RUNTIME_DEPENDENCIES
    EXECUTABLES ${executables}
    LIBRARIES "${embedder}" ${vcpkg_files}
    DIRECTORIES "${engine_libraries}" "${vcpkg_libraries}"
    RESOLVED_DEPENDENCIES_VAR resolved
    UNRESOLVED_DEPENDENCIES_VAR unresolved
    CONFLICTING_DEPENDENCIES_PREFIX conflicting
)
if (unresolved)
    list(JOIN unresolved "\n  " unresolved)
    message(FATAL_ERROR "unresolved libraries:\n  ${unresolved}")
endif()
file(REAL_PATH "${engine_libraries}" engine_libraries_real)
file(REAL_PATH "${vcpkg_libraries}" vcpkg_libraries_real)
foreach (name IN LISTS conflicting_FILENAMES)
    set(selected "")
    foreach (candidate IN LISTS conflicting_${name})
        get_filename_component(directory "${candidate}" DIRECTORY)
        file(REAL_PATH "${directory}" directory)
        if (directory STREQUAL engine_libraries_real OR directory STREQUAL vcpkg_libraries_real)
            if (selected AND NOT selected STREQUAL candidate)
                message(FATAL_ERROR "${name} resolves to more than one bundled file: ${selected}; ${candidate}")
            endif()
            set(selected "${candidate}")
        elseif (NOT candidate MATCHES "^/(usr/)?lib(64)?/")
            message(FATAL_ERROR "${name} resolves outside the selected profile and system libraries: ${candidate}")
        endif()
    endforeach()
    if (NOT selected)
        message(FATAL_ERROR "${name} resolves to more than one host file: ${conflicting_${name}}")
    endif()
    list(APPEND resolved "${selected}")
endforeach()

set(bundled "${embedder}" ${vcpkg_files})
set(host)
foreach (library IN LISTS resolved)
    get_filename_component(directory "${library}" DIRECTORY)
    file(REAL_PATH "${directory}" directory)
    if (directory STREQUAL engine_libraries_real OR directory STREQUAL vcpkg_libraries_real)
        list(APPEND bundled "${library}")
    elseif (library MATCHES "^/(usr/)?lib(64)?/")
        get_filename_component(name "${library}" NAME)
        list(APPEND host "${name}")
    else()
        message(FATAL_ERROR "${library} is outside ${engine_libraries}, ${vcpkg_libraries} and the system library "
            "directories; refusing a library from another profile or an unsupported location")
    endif()
endforeach()
list(REMOVE_DUPLICATES bundled)

function(stage_file source destination)
    set(link "${source}")
    while (TRUE)
        get_filename_component(name "${link}" NAME)
        file(REAL_PATH "${link}" real)
        get_property(previous GLOBAL PROPERTY "photon_staged:${destination}/${name}")
        if (previous AND NOT previous STREQUAL real)
            message(FATAL_ERROR "${destination}/${name} would come from both ${previous} and ${real}")
        endif()
        set_property(GLOBAL PROPERTY "photon_staged:${destination}/${name}" "${real}")
        if (NOT IS_SYMLINK "${link}")
            break()
        endif()
        file(READ_SYMLINK "${link}" target)
        if (NOT IS_ABSOLUTE "${target}")
            get_filename_component(directory "${link}" DIRECTORY)
            set(target "${directory}/${target}")
        endif()
        set(link "${target}")
    endwhile()
    file(COPY "${source}" DESTINATION "${destination}" FOLLOW_SYMLINK_CHAIN)
endfunction()

set(source_files ${executables} ${bundled} ${resource_files})
list(REMOVE_DUPLICATES source_files)
foreach (source IN LISTS source_files)
    file(SHA256 "${source}" digest)
    set_property(GLOBAL PROPERTY "photon_input:${source}" "${digest}")
endforeach()

foreach (library IN LISTS bundled)
    get_filename_component(name "${library}" NAME)
    if (name MATCHES "^(ld-linux.*|lib(c|m|dl|rt|pthread|GL|GLX|EGL|GLESv2|OpenGL|vulkan|drm|gbm)\\.so.*)$")
        message(FATAL_ERROR "refusing to bundle the host platform library ${library}")
    endif()
    stage_file("${library}" "${STAGE}/lib")
endforeach()
foreach (executable IN LISTS executables)
    stage_file("${executable}" "${STAGE}/bin")
endforeach()
file(COPY "${resources}" DESTINATION "${STAGE}/share")

file(COPY "${engine_CMAKE_HOME_DIRECTORY}/LICENSE" DESTINATION "${STAGE}/share/licenses/Engine")
file(GLOB notices "${vcpkg_root}/share/*/copyright")
foreach (notice IN LISTS notices)
    get_filename_component(port "${notice}" DIRECTORY)
    get_filename_component(port "${port}" NAME)
    file(COPY "${notice}" DESTINATION "${STAGE}/share/licenses/vcpkg/${port}")
endforeach()

get_filename_component(app_name "${APP}" NAME)
file(GLOB bundled_names LIST_DIRECTORIES false RELATIVE "${STAGE}/lib" "${STAGE}/lib/*")
file(GLOB staged_executables LIST_DIRECTORIES false "${STAGE}/bin/*")
file(GLOB staged_libraries LIST_DIRECTORIES false "${STAGE}/lib/*")
foreach (file IN LISTS staged_executables staged_libraries)
    if (IS_SYMLINK "${file}")
        continue()
    endif()
    read_elf("${file}" dump)
    if (file STREQUAL "${STAGE}/bin/${app_name}" AND NOT dump MATCHES "NEEDED +liblagom-photonembedder\\.so")
        message(FATAL_ERROR "${APP} does not load Photon Engine; it is a UI-only build")
    endif()
    if (file IN_LIST staged_executables)
        set(runpath "$ORIGIN/../lib")
    else()
        set(runpath "$ORIGIN")
    endif()
    if (dump MATCHES "\n +(RUNPATH|RPATH) ")
        file(RPATH_SET FILE "${file}" NEW_RPATH "${runpath}")
        continue()
    endif()
    string(REGEX MATCHALL "NEEDED +[^\n]+" needed "${dump}")
    foreach (entry IN LISTS needed)
        string(REGEX REPLACE "^NEEDED +" "" name "${entry}")
        if (name IN_LIST bundled_names)
            message(FATAL_ERROR "${file} needs the bundled ${name} but has no RUNPATH entry to rewrite")
        endif()
    endforeach()
endforeach()

list(REMOVE_DUPLICATES host)
list(SORT host)
list(JOIN host "\n" host)
file(WRITE "${STAGE}/HOST-LIBRARIES" "${host}\n")

foreach (source IN LISTS source_files)
    file(SHA256 "${source}" digest)
    get_property(original GLOBAL PROPERTY "photon_input:${source}")
    if (NOT digest STREQUAL original)
        message(FATAL_ERROR "${source} changed during staging; finish the build before packaging")
    endif()
endforeach()
