+void BrowserView::UpdateVerticalLocationBar(
+    HeliumLayoutStateController* controller) {
+  if (!controller || !toolbar_ || !vertical_tab_strip_region_view_ ||
+      !toolbar_->location_bar_view()) {
+    return;
+  }
+
+  const bool show_in_sidebar =
+      controller->IsVerticalLayout() &&
+      browser_->profile()->GetPrefs()->GetBoolean(
+          prefs::kHeliumVerticalLocationBar);
+  views::View* location_bar_view = toolbar_->location_bar_view();
+
+  if (show_in_sidebar && location_bar_view->parent() !=
+                             vertical_tab_strip_region_view_) {
+    location_bar_insertion_index_ = toolbar_->GetIndexOf(location_bar_view);
+    std::unique_ptr<views::View> owned_view =
+        toolbar_->RemoveChildViewT(location_bar_view);
+    vertical_tab_strip_region_view_->SetLocationBarView(std::move(owned_view));
+  } else if (!show_in_sidebar && location_bar_view->parent() ==
+                                     vertical_tab_strip_region_view_) {
+    std::unique_ptr<views::View> owned_view =
+        vertical_tab_strip_region_view_->RemoveLocationBarView();
+    if (location_bar_insertion_index_) {
+      toolbar_->AddChildViewAt(std::move(owned_view),
+                               location_bar_insertion_index_.value());
+    } else {
+      toolbar_->AddChildView(std::move(owned_view));
+    }
+  }
+
+  if (!show_in_sidebar) {
+    toolbar_->UpdateToolbarLayout();
+  }
+  InvalidateLayout();
+}
