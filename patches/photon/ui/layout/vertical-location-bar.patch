+void VerticalTabStripRegionView::SetLocationBarView(
+    std::unique_ptr<views::View> location_bar_view) {
+  CHECK(!location_bar_view_);
+
+  location_bar_view_ = AddChildView(std::move(location_bar_view));
+  location_bar_view_->SetProperty(
+      views::kFlexBehaviorKey,
+      views::FlexSpecification(views::MinimumFlexSizeRule::kPreferred,
+                               views::MaximumFlexSizeRule::kPreferred));
+  location_bar_view_->SetProperty(
+      views::kMarginsKey, gfx::Insets::TLBR(8, 6, 8, 6));
+  location_bar_view_->SetPreferredSize(gfx::Size(0, 48));
+  ReorderChildView(location_bar_view_, 0);
+  location_bar_view_->SetVisible(
+      state_controller_->GetCollapseState() !=
+      tabs::VerticalTabStripCollapseState::kCollapsed);
+  InvalidateLayout();
+}
+
+std::unique_ptr<views::View> VerticalTabStripRegionView::RemoveLocationBarView() {
+  if (!location_bar_view_) {
+    return nullptr;
+  }
+
+  std::unique_ptr<views::View> location_bar_view =
+      RemoveChildViewT(location_bar_view_);
+  location_bar_view_ = nullptr;
+  return location_bar_view;
+}
